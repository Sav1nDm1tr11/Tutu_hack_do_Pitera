# ─────────────────────────────────────────────────────────────────────────────
# «ТуТу План Б» — пример конфигурации. Скопируйте в .env и заполните.
# Переменные БЕЗ префикса VITE_ доступны только серверу и не попадают в bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Сервер ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# ── Источник инвентаря ───────────────────────────────────────────────────────
# fixture — детерминированные демо-данные (по умолчанию; live MCP недостижим,
#           см. docs/MCP_SPIKE_REPORT.md)
# live    — реальный Tutu MCP; требует достижимого TUTU_MCP_URL
# auto    — попытка live с автоматическим откатом на fixture
INVENTORY_MODE=fixture

TUTU_MCP_URL=https://mcp.tutu.ru/mcp
# Заполнить только если MCP потребует авторизацию (обнаруживается через mcp:inspect).
# TUTU_MCP_AUTH_TOKEN=

# ── LLM (опционально, OpenAI-совместимый провайдер) ──────────────────────────
# По умолчанию — OpenRouter и бесплатная модель, не GPT.
# Без ключа приложение работает в deterministic-режиме: happy path сохраняется.
# LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Самая крупная бесплатная chat-модель в каталоге OpenRouter (Nemotron 3 Ultra 550B).
# Запасные бесплатные: z-ai/glm-5.2:free  google/gemma-4-31b-it:free  openai/gpt-oss-20b:free
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODE=auto

# ── Бюджеты агента (§11.5 системного дизайна) ───────────────────────────────
MAX_AGENT_STEPS=6
MAX_LLM_CALLS_PER_PLAN=2
MAX_MCP_TOOL_CALLS_PER_PLAN=10
MCP_CALL_TIMEOUT_MS=8000
PLAN_TOTAL_TIMEOUT_MS=30000
MAX_SCHEMA_REPAIR_ATTEMPTS=1
MAX_FALLBACK_STAGES=2
MAX_FALLBACK_OPTIONS_PER_STAGE=2

# ── Хранение планов ─────────────────────────────────────────────────────────
PLAN_TTL_MS=86400000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ── Клиент (попадает в bundle — секретов быть не должно) ────────────────────
# Production обязан задать собственный tile provider с корректной attribution.
# Demo-стиль MapLibre не является production provider.
# VITE_MAP_STYLE_URL=

# Оставьте пустым в разработке: Vite проксирует `/api` на API-сервер.
# В production Fastify раздаёт web-сборку с того же origin, отдельный base не нужен.
# VITE_API_BASE_URL=
