{
  "name": "@tutu-plan-b/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: orchestrator, inventory-адаптеры, LLM-адаптер, TTL repository.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "echo \"api исполняется через tsx; отдельный бандл не требуется\"",
    "mcp:inspect": "tsx src/scripts/mcp-inspect.ts",
    "eval": "tsx src/scripts/agent-eval.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tutu-plan-b/domain": "workspace:*",
    "@tutu-plan-b/test-fixtures": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "openai": "7.5.0",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3"
  }
}
